#!/usr/bin/env bash
# Developer shortcuts for graftui. Run ./dev to list them. macOS and Linux; on Windows use the dotnet commands in CONTRIBUTING.md.
set -euo pipefail
cd "$(dirname "$0")"

[ -n "${HOME:-}" ] || { echo "dev: HOME is not set" >&2; exit 1; }

PROJECT=src/graftui/graftui.csproj
APP_DIR="$HOME/.local/share/graftui"
BIN_DIR="$HOME/.local/bin"
SANDBOX="$HOME/.graftui/sandbox"
WRAPPER_MARK="# installed by graftui ./dev install"

usage() {
  cat <<'EOF'
Usage: ./dev <command>

  install   publish a Release build and put a graftui command in ~/.local/bin
  sandbox   rebuild the practice repo at ~/.graftui/sandbox and open it
  open      reopen the practice repo without rebuilding it
  edits     make unstaged changes in the practice repo (graftui --make-edits)
  test      run the tests
EOF
}

need_dotnet() {
  command -v dotnet >/dev/null 2>&1 || { echo "dev: dotnet not found; install the .NET 10 SDK" >&2; exit 1; }
}

install() {
  need_dotnet

  # Refuse before publishing when ~/.local/bin/graftui is a file ./dev did not write.
  if [ -e "$BIN_DIR/graftui" ] || [ -L "$BIN_DIR/graftui" ]; then
    if ! grep -qF "$WRAPPER_MARK" "$BIN_DIR/graftui" 2>/dev/null; then
      echo "dev: $BIN_DIR/graftui exists and was not installed by ./dev; move it away first" >&2
      exit 1
    fi
  fi

  # Publish into a new folder first, so a failed publish leaves the previous install in place.
  rm -rf "$APP_DIR.new"
  dotnet publish "$PROJECT" -c Release -o "$APP_DIR.new" --nologo
  rm -rf "$APP_DIR"
  mv "$APP_DIR.new" "$APP_DIR"

  mkdir -p "$BIN_DIR"
  cat > "$BIN_DIR/graftui" <<EOF
#!/bin/sh
$WRAPPER_MARK
exec "$APP_DIR/graftui" "\$@"
EOF
  chmod +x "$BIN_DIR/graftui"

  echo "dev: installed $("$BIN_DIR/graftui" --version)"
  case ":$PATH:" in
    *":$BIN_DIR:"*)
      echo "dev: run it with: graftui"
      ;;
    *)
      echo "dev: ~/.local/bin is not on your PATH. Add this line to ~/.zshrc or ~/.bashrc, then open a new terminal:"
      echo '  export PATH="$HOME/.local/bin:$PATH"'
      ;;
  esac
}

cmd="${1:-}"
if [ $# -gt 0 ]; then
  shift
fi

case "$cmd" in
  install)
    install
    ;;
  sandbox)
    need_dotnet
    exec dotnet run --project "$PROJECT" -- --sandbox "$@"
    ;;
  open)
    need_dotnet
    exec dotnet run --project "$PROJECT" -- "$SANDBOX" "$@"
    ;;
  edits)
    need_dotnet
    exec dotnet run --project "$PROJECT" -- --make-edits
    ;;
  test)
    need_dotnet
    exec dotnet test graftui.slnx "$@"
    ;;
  ""|help|-h|--help)
    usage
    ;;
  *)
    echo "dev: unknown command '$cmd'" >&2
    usage >&2
    exit 2
    ;;
esac
